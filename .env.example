# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena tus valores.
# Vite solo expone las variables que empiezan por VITE_.

# Clave de la API de noticias (https://newsapi.org)
VITE_NEWS_API_KEY=

# URL base de la API de autenticación (registro/login).
# Temporalmente puedes crearla en https://mockapi.io
VITE_AUTH_API_URL=
